{
  "name": "lingoflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "version": "node scripts/write-version.js",
    "install:all": "npm install",
    "dev": "npm run version && concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "translate:language": "node --experimental-strip-types scripts/libretranslate/index.ts",
    "db:import-sqlite": "node --experimental-strip-types scripts/import-sqlite-to-postgres.ts",
    "build": "npm run version && npm run build --prefix client",
    "vercel-build": "npm run version && npm run build --prefix server && npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm run version && npm run test:server && npm run test:client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "test:server:pg": "node --experimental-strip-types scripts/test-postgres.ts",
    "lint": "npm run version && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run lint && npm run test:client",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0",
    "minimatch": "^10.2.6"
  }
}
