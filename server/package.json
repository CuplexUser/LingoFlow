{
  "name": "lingoflow-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=content --experimental-strip-types src/index.ts",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build:dist": "node -e \"const esbuild=require('esbuild');require('fs').mkdirSync('dist',{recursive:true});esbuild.buildSync({entryPoints:['src/index.ts'],bundle:true,platform:'node',format:'cjs',target:'node20',packages:'external',minify:true,sourcemap:true,outfile:'dist/index.js'});\"",
    "build": "npm run typecheck && npm run build:dist",
    "start:dist": "node dist/index.js",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
