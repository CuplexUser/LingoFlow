LINGOFLOW_AUTH_SECRET=change-me-in-production

PUBLIC_APP_URL=http://localhost:5173
EMAIL_FROM=LingoFlow <no-reply@lingoflow.local>

# Optional: Google OAuth2 sign-in
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Email delivery (if both are omitted, verification links are printed to server logs in dev)

# Preferred: Resend (https://resend.com) HTTPS API. Takes priority over SMTP when set.
# RESEND_API_KEY=re_your_resend_api_key

# Fallback: SMTP, used when RESEND_API_KEY is unset.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# Optional: community contribution moderation access
# The first registered user is always treated as a reviewer/admin.
# CONTRIBUTION_REVIEWER_EMAILS=reviewer@example.com,second-reviewer@example.com

# Word translation API — LibreTranslate (for hover tooltips in reverse-translation exercises)
# Self-host with Docker: docker run -it -p 5000:5000 libretranslate/libretranslate --api-keys
# Then generate a key: docker exec <container> ltmanage keys add
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=your-generated-key

# Optional: Logging
# LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────────
# LingoFlow runs on either SQLite or PostgreSQL.

# LINGOFLOW_DB_DRIVER — which backend to use.
#   Valid values: sqlite | postgres
#   Unset (default): postgres if DATABASE_URL is set, otherwise sqlite.
# LINGOFLOW_DB_DRIVER=sqlite

# LINGOFLOW_DB_PATH — SQLite only. Path to the database file.
#   Valid values: any writable file path, absolute or relative to server/
#   Default: ./data/lingoflow.db
# LINGOFLOW_DB_PATH=./data/lingoflow.db

# DATABASE_URL — Postgres only. Use Neon's POOLED connection string.
#   Valid values: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#   Setting this switches the server to Postgres unless LINGOFLOW_DB_DRIVER=sqlite.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Copy an existing SQLite database into Postgres once. Run from the REPO ROOT
# (the script is registered there, alongside the other scripts/ entry points).
# It always reads SQLite and writes Postgres, whatever LINGOFLOW_DB_DRIVER is set to:
#   npm run db:import-sqlite
#   npm run db:import-sqlite -- --dry-run
